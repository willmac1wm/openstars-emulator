{
  "name": "openstars-emulator",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "fetch-voice": "node scripts/fetch-kokoro-assets.mjs",
    "fetch-whisper": "node scripts/fetch-whisper-assets.mjs",
    "fetch-desktop-models": "node scripts/fetch-desktop-models.mjs",
    "prebuild": "npm run fetch-voice && npm run fetch-whisper",
    "build": "tsc && vite build",
    "build:desktop": "cross-env VITE_OPENSTARS_DESKTOP=1 npm run build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:tutorial-e2e": "node scripts/tutorial-e2e.mjs",
    "start": "vite --port 8080 --host",
    "cap": "capacitor",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@capacitor/core": "^5.7.0",
    "@capacitor/ios": "^5.7.0",
    "@capacitor/screen-orientation": "^5.0.0",
    "@google/genai": "^0.10.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-os": "^2.4.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-shell": "^2.6.0",
    "kokoro-js": "^1.2.1",
    "lucide-react": "^0.344.0",
    "posthog-js": "^1.100.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^5.7.0",
    "@tailwindcss/vite": "^4.1.17",
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^4.2.1",
    "cross-env": "^10.1.0",
    "playwright": "^1.57.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.2.2",
    "vite": "^5.1.4",
    "vitest": "^3.2.7"
  }
}
