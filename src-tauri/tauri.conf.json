{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenSTARS",
  "version": "0.1.0"
  ,
  "identifier": "org.openstars.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:8080",
    "beforeBuildCommand": "VITE_OPENSTARS_DESKTOP=1 npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenSTARS",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "maximized": false
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: https://asset.localhost ipc: http://ipc.localhost; img-src 'self' asset: data: blob:; media-src 'self' asset: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost asset: https://asset.localhost; worker-src 'self' blob:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "OpenSTARS",
    "category": "Game",
    "shortDescription": "Offline ATC radar game for classrooms and STEM expos",
    "longDescription": "OpenSTARS desktop — fully offline STARS-style ATC training with native Whisper speech recognition and Kokoro pilot voices. No accounts, no analytics, no API keys.",
    "copyright": "OpenSTARS",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/models/**/*",
      "resources/LICENSE-THIRD-PARTY.md"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 },
        "windowSize": { "width": 660, "height": 400 }
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US"
      }
    },
    "targets": "all"
  },
  "plugins": {}
}
